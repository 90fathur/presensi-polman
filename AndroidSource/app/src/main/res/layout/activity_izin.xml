<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F9FAFB"
    android:orientation="vertical">

    <!-- Header -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#2E7D32"
        android:padding="16dp"
        android:orientation="horizontal"
        android:gravity="center_vertical">
        <ImageView
            android:id="@+id/btnBack"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:src="@android:drawable/ic_menu_revert"
            android:tint="@color/white"/>
        <TextView
            android:id="@+id/tvTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:text="Pengajuan Izin"
            android:textColor="@color/white"
            android:textSize="18sp"
            android:textStyle="bold" />
    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:padding="24dp">
        
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- Kategori -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Kategori"
                android:textColor="#888888"
                android:textSize="12sp"
                android:textStyle="bold" />
            <EditText
                android:id="@+id/edtKategori"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:padding="12dp"
                android:background="@android:drawable/edit_text"
                android:enabled="false"
                android:textColor="#333333"
                android:textStyle="bold" />

            <!-- Sub Kategori -->
            <LinearLayout
                android:id="@+id/wrapperSubKategori"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:text="Sub Kategori"
                    android:textColor="#888888"
                    android:textSize="12sp"
                    android:textStyle="bold" />
                <TextView
                    android:id="@+id/tvSubKategori"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:padding="12dp"
                    android:background="@android:drawable/edit_text"
                    android:text="Pilih Sub Kategori"
                    android:textColor="#333333" />
            </LinearLayout>

            <!-- Slot Waktu -->
            <LinearLayout
                android:id="@+id/wrapperSlotWaktu"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:text="Slot Waktu"
                    android:textColor="#888888"
                    android:textSize="12sp"
                    android:textStyle="bold" />
                <TextView
                    android:id="@+id/tvSlotWaktu"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:padding="12dp"
                    android:background="@android:drawable/edit_text"
                    android:text="Satu Hari Penuh"
                    android:textColor="#333333" />
            </LinearLayout>

            <!-- Tanggal Mulai -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="Tanggal Mulai"
                android:textColor="#888888"
                android:textSize="12sp"
                android:textStyle="bold" />
            <TextView
                android:id="@+id/tvTglMulai"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:padding="12dp"
                android:background="@android:drawable/edit_text"
                android:text="Pilih Tanggal Mulai"
                android:textColor="#333333" />

            <!-- Tanggal Selesai -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="Tanggal Selesai"
                android:textColor="#888888"
                android:textSize="12sp"
                android:textStyle="bold" />
            <TextView
                android:id="@+id/tvTglSelesai"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:padding="12dp"
                android:background="@android:drawable/edit_text"
                android:text="Pilih Tanggal Selesai"
                android:textColor="#333333" />

            <!-- Keterangan -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="Keterangan / Alasan"
                android:textColor="#888888"
                android:textSize="12sp"
                android:textStyle="bold" />
            <EditText
                android:id="@+id/edtKeterangan"
                android:layout_width="match_parent"
                android:layout_height="100dp"
                android:layout_marginTop="8dp"
                android:padding="12dp"
                android:background="@android:drawable/edit_text"
                android:gravity="top|start"
                android:hint="Tuliskan alasan lengkap..."
                android:textColor="#333333" />

            <!-- Upload Bukti -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="Bukti Lampiran (Foto/PDF)"
                android:textColor="#888888"
                android:textSize="12sp"
                android:textStyle="bold" />
            <Button
                android:id="@+id/btnPilihFile"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="📁 Pilih File"
                android:backgroundTint="#EEEEEE"
                android:textColor="#333333" />
            <TextView
                android:id="@+id/tvNamaFile"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="Tidak ada file terpilih"
                android:textColor="#F57F17"
                android:textStyle="italic" />

            <!-- Submit -->
            <Button
                android:id="@+id/btnSubmit"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:layout_marginTop="32dp"
                android:text="AJUKAN SEKARANG"
                android:backgroundTint="#2E7D32"
                android:textColor="@color/white"
                android:textStyle="bold" />
                
        </LinearLayout>
    </ScrollView>

</LinearLayout>
